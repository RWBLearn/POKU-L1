<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Кто хочет стать миллионером — Wildberries</title>
<style>
  * { box-sizing: border-box; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
    background: radial-gradient(circle at 50% 0%, #1b2a5e 0%, #0b1230 60%, #05081a 100%);
    margin: 0; min-height: 100vh;
    padding: 24px 12px 60px;
    color: #eef2ff;
    line-height: 1.5;
  }
  .game {
    max-width: 1020px; margin: 0 auto;
    display: grid; grid-template-columns: 1fr 240px; gap: 20px;
  }
  @media (max-width: 820px) {
    .game { grid-template-columns: 1fr; }
    .ladder { order: -1; }
  }

  .header {
    grid-column: 1 / -1;
    text-align: center; margin-bottom: 4px;
  }
  .header h1 {
    font-size: 26px; margin: 0 0 4px;
    background: linear-gradient(90deg, #ffd76a, #ffb02e, #ffd76a);
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent;
    letter-spacing: .5px;
  }
  .header p { margin: 0; color: #9fb0d8; font-size: 14px; }

  .board {
    background: linear-gradient(180deg, #101a44, #0a1130);
    border: 2px solid #2a3a75;
    border-radius: 18px;
    padding: 22px 24px 26px;
    box-shadow: 0 0 40px rgba(60, 100, 255, .15);
  }
  .q-counter {
    font-size: 13px; color: #8fa3d4; letter-spacing: 1px;
    text-transform: uppercase; margin-bottom: 8px;
  }
  .prize-now {
    font-size: 15px; color: #ffd76a; font-weight: 700;
    margin-bottom: 14px;
  }
  .question-text {
    font-size: 19px; font-weight: 600; margin-bottom: 20px;
    min-height: 56px;
    animation: fade .3s ease;
  }
  @keyframes fade {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .answers {
    display: grid; grid-template-columns: 1fr 1fr; gap: 12px;
  }
  @media (max-width: 560px) { .answers { grid-template-columns: 1fr; } }

  .answer {
    display: flex; align-items: center; gap: 12px;
    background: linear-gradient(180deg, #16224f, #0e1738);
    border: 2px solid #2c3d7d;
    border-radius: 12px;
    padding: 14px 16px;
    cursor: pointer;
    font-size: 15px; color: #eef2ff;
    text-align: left;
    transition: border-color .15s, background .15s, opacity .2s;
    font-family: inherit;
  }
  .answer:hover:not(:disabled) {
    border-color: #ffb02e;
    background: linear-gradient(180deg, #1c2b63, #121d47);
  }
  .answer:disabled { cursor: default; }
  .answer .letter {
    flex: 0 0 auto;
    width: 28px; height: 28px; border-radius: 50%;
    background: #ffb02e; color: #0b1230;
    display: flex; align-items: center; justify-content: center;
    font-weight: 800; font-size: 14px;
  }
  .answer.correct  { border-color: #35d07f; background: #123a2a; }
  .answer.correct .letter { background: #35d07f; }
  .answer.wrong    { border-color: #e05252; background: #3a1414; }
  .answer.wrong .letter { background: #e05252; color: #fff; }
  .answer.removed {
    opacity: .25;
    text-decoration: line-through;
    pointer-events: none;
  }

  /* -------- Подсказки -------- */
  .lifelines {
    display: flex; gap: 10px; flex-wrap: wrap;
    margin: 18px 0 0;
    padding-top: 16px;
    border-top: 1px solid #223066;
  }
  .lifeline {
    display: flex; align-items: center; gap: 8px;
    background: #16224f;
    border: 2px solid #2c3d7d;
    border-radius: 50px;
    padding: 8px 16px;
    font-size: 13px; font-weight: 700;
    color: #cdd8f5;
    cursor: pointer;
    font-family: inherit;
    transition: border-color .15s, background .15s, opacity .2s;
  }
  .lifeline:hover:not(:disabled) {
    border-color: #ffb02e;
    color: #ffd76a;
  }
  .lifeline:disabled {
    opacity: .3; cursor: not-allowed;
    text-decoration: line-through;
  }
  .lifeline .icon { font-size: 15px; }

  .feedback {
    margin-top: 18px;
    border-radius: 12px;
    padding: 14px 16px;
    font-size: 14px;
    display: none;
    animation: fade .3s ease;
  }
  .feedback.show { display: block; }
  .feedback.ok  { background: #123a2a; border: 1px solid #35d07f; color: #b6f0d0; }
  .feedback.err { background: #3a1414; border: 1px solid #e05252; color: #f6c6c6; }
  .feedback.warn{ background: #3a2f14; border: 1px solid #ffb02e; color: #ffe6b0; }
  .feedback b { color: #fff; }

  .controls {
    margin-top: 18px; display: flex; gap: 12px; flex-wrap: wrap;
  }
  .btn {
    font-size: 15px; font-weight: 700;
    border-radius: 10px; padding: 12px 22px;
    border: none; cursor: pointer;
    font-family: inherit;
    transition: filter .15s;
  }
  .btn:hover:not(:disabled) { filter: brightness(1.1); }
  .btn:disabled { opacity: .4; cursor: not-allowed; }
  .btn-gold  { background: linear-gradient(180deg, #ffd76a, #ffb02e); color: #0b1230; }
  .btn-ghost { background: #1c2b63; color: #cdd8f5; }

  .ladder {
    background: linear-gradient(180deg, #101a44, #0a1130);
    border: 2px solid #2a3a75;
    border-radius: 18px;
    padding: 14px 10px;
    display: flex; flex-direction: column-reverse;
    gap: 2px;
    align-self: start;
  }
  .ladder-item {
    display: flex; justify-content: space-between;
    padding: 5px 12px;
    font-size: 13px;
    border-radius: 8px;
    color: #7f92c4;
  }
  .ladder-item .num { font-weight: 700; }
  .ladder-item.safe { color: #ffd76a; font-weight: 700; }
  .ladder-item.current {
    background: #ffb02e; color: #0b1230; font-weight: 800;
  }
  .ladder-item.passed { color: #35d07f; }

  .final {
    display: none;
    text-align: center;
    padding: 30px 20px;
  }
  .final.show { display: block; animation: fade .4s ease; }
  .final h2 {
    font-size: 24px; margin: 0 0 12px;
    background: linear-gradient(90deg, #ffd76a, #ffb02e);
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .final .sum {
    font-size: 44px; font-weight: 900; color: #ffd76a;
    margin: 8px 0 6px;
  }
  .final .sub { color: #9fb0d8; font-size: 15px; margin-bottom: 22px; }
</style>
</head>
<body>
<div class="game">
  <div class="header">
    <h1>Кто хочет стать миллионером</h1>
    <p>Интерфейс Wildberries для покупателя · 14 вопросов · 3 подсказки</p>
  </div>

  <div class="board" id="board">
    <div class="q-counter" id="qCounter">Вопрос 1 из 14</div>
    <div class="prize-now" id="prizeNow">На кону: 100 · в банке: 0</div>
    <div class="question-text" id="questionText"></div>
    <div class="answers" id="answers"></div>

    <div class="lifelines" id="lifelines"></div>

    <div class="feedback" id="feedback"></div>
    <div class="controls" id="controls"></div>
  </div>

  <div class="ladder" id="ladder"></div>
</div>

<script>
/* ------------------------------------------------------------------
   ВОПРОСЫ
------------------------------------------------------------------- */
const QUESTIONS = [
  {
    q: "Где покупатель может пользоваться маркетплейсом Wildberries?",
    options: [
