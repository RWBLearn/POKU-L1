    correct: 0,
    comment: "Wildberries доступен покупателю и через сайт, и через мобильное приложение. Регистрация не ограничивает способ входа: один и тот же ЛК работает везде."
  },
  {
    q: "В какой валюте отображаются цены на сайте Wildberries для покупателей из Армении?",
    options: ["Драм", "Российский рубль", "Кыргызский сом", "Лари"],
    correct: 0,
    comment: "Для покупателей из Армении цены отображаются в драмах — местной валюте страны покупателя."
  },
  {
    q: "Для чего в Веб-КЦ используется перевод чатов между поддержками?",
    options: [
      "Для перевода обращения в нужную поддержку в зависимости от страны покупателя",
      "Для изменения языка интерфейса оператора",
      "Для автоматического ответа на часто задаваемые вопросы",
      "Для перевода обращения к эксперту"
    ],
    correct: 0,
    comment: "Перевод чатов между поддержками нужен, чтобы обращение попало в ту поддержку, которая отвечает за страну покупателя (международную или российскую)."
  },
  {
    q: "Что используется для авторизации покупателя во всех приложениях Wildberries?",
    options: ["Номер мобильного телефона (WB ID)", "Адрес электронной почты", "Номер паспорта", "ФИО"],
    correct: 0,
    comment: "Единый идентификатор покупателя во всех приложениях — номер мобильного телефона (WB ID)."
  },
  {
    q: "Возможно ли наличие двух личных кабинетов (ЛК) с одним номером телефона?",
    options: [
      "Нет",
      "Да, для стран СНГ",
      "Да, если один ЛК в России, а другой — в Казахстане",
      "Да, если пользоваться сайтом и приложением"
    ],
    correct: 0,
    comment: "Два ЛК с одним номером телефона невозможны — номер телефона уникален и привязан к одному кабинету."
  },
  {
    q: "Как нужно консультировать покупателя по вопросам, связанным с офертой?",
    options: [
      "Сначала проконсультировать самостоятельно, при необходимости сослаться на пункт оферты",
      "Отправить покупателю полный текст оферты",
      "Предоставить скриншот из оферты",
      "Сказать, что информацию можно найти в интернете"
    ],
    correct: 0,
    comment: "Правильный подход: сначала дать консультацию самому, а затем при необходимости сослаться на конкретный пункт оферты."
  },
  {
    q: "Что нужно сделать оператору в первую очередь, если покупатель сообщает, что код для входа в ЛК не приходит?",
    options: [
      "Проверить новости о массовой проблеме, затем в Веб-КЦ раздел «Уведомления»",
      "Перевести чат на эксперта",
      "Сообщить покупателю код самостоятельно",
      "Попросить подождать и перезвонить через час"
    ],
    correct: 0,
    comment: "Сначала проверяем новости о массовых проблемах, затем — отправлялся ли код в разделе «Уведомления» (лента клиента) в Веб-КЦ."
  },
  {
    q: "Какое максимальное количество товаров может добавить в корзину покупатель из России с подпиской WB Клуба?",
    options: ["До 510 товаров", "До 1500 товаров", "До 255 товаров", "До 500 товаров"],
    correct: 0,
    comment: "С подпиской WB Клуба покупатель из России может добавить в корзину до 510 товаров."
  },
  {
    q: "Куда покупателю нужно зайти, чтобы найти QR-код и шестизначный код выдачи товара?",
    options: ["Профиль — Заказы", "Профиль — Покупки", "Профиль — Избранное", "Профиль — Возврат товара"],
    correct: 0,
    comment: "QR-код и шестизначный код выдачи находятся в разделе «Профиль — Заказы»."
  },
  {
    q: "Если покупатель просит вернуть отображение скрытого товара из истории покупок, что должен сделать оператор?",
    options: [
      "Обратиться к эксперту",
      "Самостоятельно восстановить отображение",
      "Сообщить, что это невозможно",
      "Попросить заново добавить товар в корзину"
    ],
    correct: 0,
    comment: "В этом случае оператор обращается к эксперту — самостоятельно восстановить отображение нельзя."
  },
  {
    q: "В какой срок покупатель может вернуть товар надлежащего качества, если он не подошёл?",
    options: ["В течение 14 дней", "В течение 5 дней", "В течение 30 дней", "В течение 7 дней"],
    correct: 0,
    comment: "Товар надлежащего качества можно вернуть в течение 14 дней."
  },
  {
    q: "Через сколько дней после получения заказа начисляется кешбэк «Ягодки» при соблюдении всех условий?",
    options: ["На 15-й день", "На 5-й день", "На 30-й день", "На следующий день"],
    correct: 0,
    comment: "Кешбэк «Ягодки» начисляется на 15-й день после получения заказа при соблюдении всех условий."
  },
  {
    q: "Что делать оператору, если отзыв имеет статус «Не опубликован» без даты и в карточке товара его нет?",
    options: [
      "Обратиться к эксперту",
      "Сообщить, что отзыв нарушает правила",
      "Попросить написать отзыв заново",
      "Оформить проблему «Отзывы. Не учитывается в рейтинге»"
    ],
    correct: 0,
    comment: "В такой ситуации оператор обращается к эксперту."
  },
  {
    q: "В течение какого времени можно оставить отзыв на товар со специальным значком, чтобы получить бонусные рубли?",
    options: [
      "В течение 5 дней после получения",
      "В течение 15 дней после получения",
      "В течение 3 дней после получения",
      "В течение 1 дня после получения"
    ],
    correct: 0,
    comment: "Отзыв на товар со специальным значком нужно оставить в течение 5 дней после получения, чтобы получить бонусные рубли."
  }
];

/* ------------------------------------------------------------------
   НАСТРОЙКИ
------------------------------------------------------------------- */
const LETTERS = ['A', 'B', 'C', 'D'];
const SAFE_LEVELS = [5, 10];
const LADDER = [
  100, 200, 300, 500, 1000,
  2000, 4000, 8000, 16000, 32000,
  64000, 125000, 250000, 500000
];

/* ------------------------------------------------------------------
   СОСТОЯНИЕ
------------------------------------------------------------------- */
let current = 0;
let bank = 0;
let finished = false;
let answered = false;

// подсказки: доступны, пока не использованы
const lifelines = {
  fifty: true,     // 50:50 — убрать 2 неверных
  minus: true,     // убрать 1 неверный
  second: true     // право на ошибку
};

// для права на ошибку: была ли уже ошибка на текущем вопросе
let secondChanceUsed = false;

const board = document.getElementById('board');
const qCounter = document.getElementById('qCounter');
const prizeNow = document.getElementById('prizeNow');
const questionText = document.getElementById('questionText');
const answersEl = document.getElementById('answers');
const lifelinesEl = document.getElementById('lifelines');
const feedbackEl = document.getElementById('feedback');
const controlsEl = document.getElementById('controls');
const ladderEl = document.getElementById('ladder');

/* ------------------------------------------------------------------
   ЛЕСТНИЦА
------------------------------------------------------------------- */
function renderLadder() {
  ladderEl.innerHTML = LADDER.map((sum, i) => {
    const level = i + 1;
    let cls = 'ladder-item';
    if (level === current + 1 && !finished) cls += ' current';
    else if (level <= current) cls += ' passed';
    if (SAFE_LEVELS.includes(level)) cls += ' safe';
    return `<div class="${cls}">
      <span class="num">${level}</span>
      <span>${sum.toLocaleString('ru-RU')}</span>
    </div>`;
  }).join('');
}

/* ------------------------------------------------------------------
   ПОДСКАЗКИ — РЕНДЕР
------------------------------------------------------------------- */
function renderLifelines() {
  lifelinesEl.innerHTML = `
    <button class="lifeline" id="ll-fifty" ${lifelines.fifty ? '' : 'disabled'}>
      <span class="icon">50:50</span> Убрать 2 неверных
    </button>
    <button class="lifeline" id="ll-minus" ${lifelines.minus ? '' : 'disabled'}>
      <span class="icon">−1</span> Убрать 1 неверный
    </button>
    <button class="lifeline" id="ll-second" ${lifelines.second ? '' : 'disabled'}>
      <span class="icon">🛡</span> Право на ошибку
    </button>
  `;

  const btnFifty = document.getElementById('ll-fifty');
  const btnMinus = document.getElementById('ll-minus');
  const btnSecond = document.getElementById('ll-second');

  if (btnFifty)  btnFifty.addEventListener('click', useFifty);
  if (btnMinus)  btnMinus.addEventListener('click', useMinus);
  if (btnSecond) btnSecond.addEventListener('click', useSecondChance);
}

/* ------------------------------------------------------------------
   ПОДСКАЗКИ — ЛОГИКА
------------------------------------------------------------------- */
function disableAnswersExcept(indices) {
  // indices — какие варианты оставить активными
  answersEl.querySelectorAll('.answer').forEach((btn, i) => {
    if (!indices.includes(i)) {
      btn.classList.add('removed');
      btn.disabled = true;
    }
  });
}

function useFifty() {
  if (!lifelines.fifty || answered) return;
  lifelines.fifty = false;

  const item = QUESTIONS[current];
  const wrong = [0, 1, 2, 3].filter(i => i !== item.correct);
  // убираем 2 неверных — оставляем правильный и один случайный неверный
  const keepWrong = wrong[Math.floor(Math.random() * wrong.length)];
  const keep = [item.correct, keepWrong].sort((a, b) => a - b);

  disableAnswersExcept(keep);
  renderLifelines();
}

function useMinus() {
  if (!lifelines.minus || answered) return;
  lifelines.minus = false;

  const item = QUESTIONS[current];
  const wrong = [0, 1, 2, 3].filter(i => i !== item.correct);
  const remove = wrong[Math.floor(Math.random() * wrong.length)];

  const btn = answersEl.querySelector(`.answer[data-i="${remove}"]`);
  if (btn) {
    btn.classList.add('removed');
    btn.disabled = true;
  }
  renderLifelines();
}

function useSecondChance() {
  if (!lifelines.second || answered) return;
  lifelines.second = false;
  renderLifelines();

  feedbackEl.className = 'feedback warn show';
  feedbackEl.innerHTML = '🛡 <b>Право на ошибку активировано.</b> Если ответите неверно — сможете попробовать ещё раз.';
}

/* ------------------------------------------------------------------
   РЕНДЕР ВОПРОСА
------------------------------------------------------------------- */
function renderQuestion() {
  answered = false;
  secondChanceUsed = false;

  const item = QUESTIONS[current];

  qCounter.textContent = `Вопрос ${current + 1} из ${QUESTIONS.length}`;
  prizeNow.textContent = `На кону: ${LADDER[current].toLocaleString('ru-RU')} · в банке: ${bank.toLocaleString('ru-RU')}`;
  questionText.textContent = item.q;

  answersEl.innerHTML = item.options.map((opt, i) => `
    <button type="button" class="answer" data-i="${i}">
      <span class="letter">${LETTERS[i]}</span>
      <span>${opt}</span>
    </button>
  `).join('');

  feedbackEl.className = 'feedback';
  feedbackEl.innerHTML = '';
  controlsEl.innerHTML = '';

  answersEl.querySelectorAll('.answer').forEach(btn => {
    btn.addEventListener('click', () => selectAnswer(Number(btn.dataset.i)));
  });

  renderLifelines();
  renderLadder();
}

/* ------------------------------------------------------------------
   ОТВЕТ
------------------------------------------------------------------- */
function selectAnswer(index) {
  if (answered) return;

  const item = QUESTIONS[current];
  const isCorrect = index === item.correct;

  if (isCorrect) {
    answered = true;
    bank = LADDER[current];

    answersEl.querySelectorAll('.answer').forEach((btn, i) => {
      btn.disabled = true;
      if (i === item.correct) btn.classList.add('correct');
    });

    feedbackEl.className = 'feedback ok show';
    feedbackEl.innerHTML = `✅ <b>Верно!</b> ${item.comment}`;

    prizeNow.textContent = `В банке: ${bank.toLocaleString('ru-RU')}`;
    renderLadder();
    renderLifelines();

    showNextControls();
    return;
  }

  // --- ответ неверный ---
  const wrongBtn = answersEl.querySelector(`.answer[data-i="${index}"]`);
  if (wrongBtn) wrongBtn.classList.add('wrong');

  // если есть право на ошибку — не заканчиваем игру
  if (lifelines.second === false && !secondChanceUsed) {
    secondChanceUsed = true;
    wrongBtn.disabled = true;
    wrongBtn.classList.add('removed');

    feedbackEl.className = 'feedback warn show';
    feedbackEl.innerHTML = `🛡 <b>Право на ошибку использовано!</b> Этот вариант неверный. Попробуйте выбрать другой.`;
    return;
  }

  // иначе — игра окончена
  answered = true;
  answersEl.querySelectorAll('.answer').forEach((btn, i) => {
    btn.disabled = true;
    if (i === item.correct) btn.classList.add('correct');
  });

  feedbackEl.className = 'feedback err show';
  feedbackEl.innerHTML = `❌ <b>Неверно.</b> Правильный ответ: <b>${item.options[item.correct]}</b><br>${item.comment}`;

  renderLifelines();

  const endBtn = document.createElement('button');
  endBtn.className = 'btn btn-gold';
  endBtn.textContent = 'Показать результат';
  endBtn.addEventListener('click', () => finishGame(false));
  controlsEl.appendChild(endBtn);
}

/* ------------------------------------------------------------------
   КНОПКИ ПОСЛЕ ВЕРНОГО ОТВЕТА
------------------------------------------------------------------- */
function showNextControls() {
  controlsEl.innerHTML = '';

  if (current < QUESTIONS.length - 1) {
    const nextBtn = document.createElement('button');
    nextBtn.className = 'btn btn-gold';
    nextBtn.textContent = 'Следующий вопрос →';
    nextBtn.addEventListener('click', () => {
      current++;
      renderQuestion();
    });
    controlsEl.appendChild(nextBtn);

    const takeBtn = document.createElement('button');
    takeBtn.className = 'btn btn-ghost';
    takeBtn.textContent = `Забрать ${bank.toLocaleString('ru-RU')}`;
    takeBtn.addEventListener('click', () => finishGame(true));
    controlsEl.appendChild(takeBtn);
  } else {
    const winBtn = document.createElement('button');
    winBtn.className = 'btn btn-gold';
    winBtn.textContent = '🏆 Забрать выигрыш!';
    winBtn.addEventListener('click', () => finishGame(true));
    controlsEl.appendChild(winBtn);
  }
}

/* ------------------------------------------------------------------
   ФИНАЛ
------------------------------------------------------------------- */
function finishGame(won) {
  finished = true;
  board.innerHTML = `
    <div class="final show">
      <h2>${won ? '🏆 Игра завершена!' : '💥 Увы, ответ неверный'}</h2>
      <div class="sum">${bank.toLocaleString('ru-RU')}</div>
      <div class="sub">
        ${won
          ? `Вы ответили правильно на ${current + 1} из ${QUESTIONS.length} вопросов.`
          : `Вы дошли до ${current + 1}-го вопроса и забираете несгораемую сумму.`}
      </div>
      <button class="btn btn-gold" onclick="location.reload()">Играть заново</button>
    </div>
  `;
}

/* ------------------------------------------------------------------
   СТАРТ
------------------------------------------------------------------- */
renderQuestion();
</script>
</body>
</html>
